# InfiniteTag sem o caractere $.
INFINITEPAY_HANDLE=

# URL HTTPS pública do site. Na Netlify, URL é preenchida automaticamente.
# Use esta variável para previews/túneis ou domínio personalizado.
PUBLIC_SITE_URL=https://seu-dominio.com.br

# Endpoint oficial atual. Só altere se a InfinitePay fornecer um sandbox.
INFINITEPAY_API_URL=https://api.checkout.infinitepay.io

# Notificação por e-mail (Resend) quando um pedido é pago. Opcional: se ausente, o envio é apenas pulado.
RESEND_API_KEY=
# Um ou mais e-mails separados por vírgula.
ORDER_NOTIFICATION_EMAIL=
# Remetente com domínio verificado na Resend.
ORDER_NOTIFICATION_FROM=pedidos@seu-dominio.com.br
